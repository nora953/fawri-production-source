# Replit
.cache/
.local/

# Fawri local runtime data — never commit
/data/
artifacts/api-server/data/
artifacts/api-server/api-server.pid

# Local-only Replit placeholders and logs
Environment
Secrets
webhook
store_id
*.log
*~

# One-off local recovery and diagnostic files
*.bak*
*.backup*
*.current.*
*.stable_*
rescue-current-*/
translation-audit-*/
*-debug.txt
build-error.txt
/pre_*.dump
/branch-archives/
scripts/.tmp-*

# Generated files in workspace packages
**/node_modules/
**/dist/
**/.replit-artifact/
**/*.tsbuildinfo

# Non-production experiments and migration work
artifacts/mockup-sandbox/
artifacts/fawri/fawri-wp-migration-review/
artifacts/fawri/wp-working-editable-build/


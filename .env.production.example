# Fawri production environment template
#
# This file is documentation only.
# Do not place real production secrets in source control.
# Populate secret values through the deployment secret store / workload identity.
#
# The variables below are derived from:
# artifacts/api-server/src/services/productionReleaseReadiness.ts
#
# This template covers the runtime configuration gate only.
# External launch blockers such as SaaS billing, production backup/restore,
# and durable support-image storage still require separate proof.

NODE_ENV=production
FAWRI_DEPLOYMENT_MODE=production
# Legacy compatibility marker; production safety no longer depends on this being present.
FAWRI_PRODUCTION_RELEASE_GATE=required

# PostgreSQL authorities
DATABASE_URL=<postgresql-production-url-from-secret-store>
FAWRI_OPERATIONAL_POSTGRES_AUTHORITY=required
FAWRI_SUBSCRIPTION_POSTGRES_AUTHORITY=required
FAWRI_AUTH_POSTGRES_SESSION_AUTHORITY=required

# Auth security
FAWRI_AUTH_SECURITY_SECRET=<random-secret-at-least-32-characters>
FAWRI_ALLOWED_ORIGINS=https://<production-host>

# Meta production cutover
FAWRI_META_CUTOVER_READY=1
FAWRI_META_REPLY_TRANSPORT=live
FAWRI_DISABLE_JOB_WORKERS=0

# Meta credential provider / AWS KMS
FAWRI_META_CREDENTIAL_PROVIDER=aws-kms
FAWRI_META_AWS_REGION=<aws-region>
FAWRI_META_AWS_KMS_KEY_ARN=arn:aws:kms:<aws-region>:<aws-account-id>:key/<kms-key-id>
FAWRI_META_AWS_CURRENT_DEK_ID=meta-dek-current
FAWRI_META_AWS_KMS_WRAPPED_DEKS_JSON={"meta-dek-current":"<base64-kms-ciphertext-blob>"}

# Meta application
META_APP_ID=<meta-app-id>
META_APP_SECRET=<meta-app-secret-at-least-16-characters>
META_CONFIG_ID=<meta-config-id>
META_REDIRECT_URI=https://<production-host>/api/meta/callback
META_VERIFY_TOKEN=<random-token-at-least-32-characters>

# Knowledge embeddings, approved-answer translation, and constrained draft generation
FAWRI_KNOWLEDGE_EMBEDDING_PROVIDER=openai
FAWRI_KNOWLEDGE_TRANSLATION_PROVIDER=openai
FAWRI_KNOWLEDGE_AI_PROVIDER=openai
OPENAI_API_KEY=<openai-api-key-from-secret-store>
FAWRI_OPENAI_MODEL=<approved-openai-response-model>

# Observability / release identity
FAWRI_SERVICE_VERSION=<safe-release-version>
FAWRI_OBSERVABILITY_BEARER_TOKEN=<random-token-at-least-32-characters>

{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "preview:replit": "node ./scripts/run-fawri-preview.mjs",
    "audit:data": "node ./scripts/audit-fawri-json-data.mjs",
    "audit:jobs": "node ./scripts/audit-fawri-background-jobs.mjs",
    "audit:manual-conversations": "node ./scripts/audit-manual-conversation-operations.mjs",
    "migration:preflight": "node ./scripts/audit-transitional-migration-readiness.mjs",
    "migration:plan": "node ./scripts/run-postgresql-migration-plan.mjs",
    "migration:test": "node --test ./scripts/tests/*.test.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "^3.8.3",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "openai": "^6.44.0",
    "zod": "catalog:"
  }
}

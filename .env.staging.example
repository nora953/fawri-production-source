# Fawri staging environment template
#
# Safe manual-QA staging only.
# Do not place production credentials or provider secrets here.
# Keep external production integrations disabled.
#
# Dockerfile.staging already supplies:
# PORT=8080
# FAWRI_WEB_DIST_DIR=/app/artifacts/fawri/dist/public

NODE_ENV=production
FAWRI_DEPLOYMENT_MODE=staging

# Staging PostgreSQL authorities
DATABASE_URL=<staging-postgresql-url-from-secret-store>
FAWRI_OPERATIONAL_POSTGRES_AUTHORITY=required
FAWRI_SUBSCRIPTION_POSTGRES_AUTHORITY=required
FAWRI_AUTH_POSTGRES_SESSION_AUTHORITY=required
FAWRI_EXPECTED_POSTGRES_RUNTIME_ROLE=<restricted-staging-runtime-role>

# Staging auth/origin
FAWRI_AUTH_SECURITY_SECRET=<random-staging-secret-at-least-32-characters>
FAWRI_PASSWORD_SALT=<independent-random-staging-secret-at-least-32-characters>
FAWRI_ALLOWED_ORIGINS=https://<staging-host>
FAWRI_SERVICE_VERSION=<staging-release-version>

# Manual-QA owner device verification only. This bypass is accepted only when
# NODE_ENV=production and FAWRI_DEPLOYMENT_MODE=staging.
FAWRI_STAGING_OTP_BYPASS=1
AUTH_INCLUDE_DEV_CODE=true

# Explicitly disabled external production surfaces
FAWRI_DISABLE_JOB_WORKERS=1
FAWRI_META_CUTOVER_READY=0
FAWRI_META_REPLY_TRANSPORT=disabled
FAWRI_KNOWLEDGE_EMBEDDING_PROVIDER=disabled

# Intentionally absent in staging:
# FAWRI_PRODUCTION_RELEASE_GATE
# FAWRI_META_CREDENTIAL_PROVIDER
# FAWRI_META_AWS_*
# META_APP_*
# META_VERIFY_TOKEN
# OPENAI_API_KEY
